
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Deployment {
  id          String   @id
  userId      String
  repoUrl     String
  status      String
  deployedUrl String?
  createdAt   DateTime @default(now())
  timeTaken   Int?
}
